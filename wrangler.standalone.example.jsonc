{
  "name": "yimiao-house",
  "main": "server/standalone-worker.js",
  "compatibility_date": "2026-10-01",
  "assets": { "directory": "dist/client", "binding": "ASSETS", "run_worker_first": ["/api/*"] },
  "vars": {
    "AUTH_PROVIDER": "supabase",
    "SUPABASE_URL": "https://your-project.supabase.co",
    "MEMBER_EMAILS": "{\"yiting\":\"your-email@example.com\",\"haomiao\":\"partner-email@example.com\"}"
  },
  "d1_databases": [{ "binding": "DB", "database_name": "yimiao-house", "database_id": "replace-with-your-real-database-id", "migrations_dir": "drizzle" }],
  "r2_buckets": [{ "binding": "BUCKET", "bucket_name": "yimiao-house-private" }]
}
