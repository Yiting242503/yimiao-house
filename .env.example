# Production server environment only. Set through Sites environment settings.
# Copy each stable user ID from /api/session after that person signs in.
# MEMBER_IDS={"yiting":"actual-site-user-id-A","haomiao":"actual-site-user-id-B"}
# Alternatively bind invited verified emails on their first successful sign-in:
# MEMBER_EMAILS={"yiting":"your-email@example.com","haomiao":"partner-email@example.com"}
# Never set LOCAL_PREVIEW in the hosted environment.

# Standalone deployment only. All auth configuration stays on the server.
# AUTH_PROVIDER=supabase
# SUPABASE_URL=https://your-project.supabase.co
# SUPABASE_PUBLISHABLE_KEY=your-supabase-publishable-key
# MEMBER_EMAILS={"yiting":"your-email@example.com","haomiao":"partner-email@example.com"}
# Do not use VITE_* variables or a Supabase service-role key for visitor auth.
